{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": { "api/quotes.js": { "maxDuration": 15 } },
  "rewrites": [{ "source": "/((?!api/|assets/).*)", "destination": "/index.html" }]
}
